generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model users {
  id               Int                   @id @default(autoincrement())
  firstName        String                @db.VarChar(100)
  lastName         String                @db.VarChar(100)
  fullName         String                @db.VarChar(201)
  email            String                @unique @db.VarChar(255)
  password_hash    String                @db.VarChar(255)
  age              Int?
  weight           Float?
  height           Float?
  diet_preferences String?
  allergies        String?
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt
  budgetRange      String?
  cookingSkill     String?
  mealPrepTime     String?

  // Relationship: A user can have many recipes
  recipes          recipes[]
  mealPlans        MealPlan[]
  resetTokens      passwordResetTokens[]

  @@map("users")
}

model passwordResetTokens {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model recipes {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  ingredients  String[]
  prep_time    Int?
  prep_steps   String[]
  cost         String?   // "Low", "Medium", "High"
  difficulty   String?   // "Easy", "Medium", "Hard"
  dietary_tags String[]
  allergens    String[]
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt
  ownerId      Int         
  
  // Relationship: A recipe belongs to a user
  owner        users    @relation(fields: [ownerId], references:[id])
  
  // Back relation to MealPlanItem
  mealPlanItems MealPlanItem[]
  
  @@map("recipes")
}

model MealPlan {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(255)
  week_start_date   DateTime
  week_end_date     DateTime
  ownerId           Int       
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relationship: A meal plan belongs to a user
  owner             users    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Relationship: A meal plan can have many meal plan items
  mealPlanItems     MealPlanItem[]

  @@unique([ownerId, week_start_date, week_end_date]) // Prevent duplicate plans for same week
  @@map("meal_plans")  
}

model MealPlanItem {
  id              Int       @id @default(autoincrement())
  mealPlanId    Int
  recipeId       Int
  day_of_week     DayOfWeek
  meal_type       MealType
  notes           String?   @db.VarChar(255)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // Relationships
  mealPlan          MealPlan      @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe            recipes       @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  
  @@unique([mealPlanId, day_of_week, meal_type])
  @@map("meal_plan_items")
}

// Enums for type safety
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}